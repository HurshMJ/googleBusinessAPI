# ---- Google Places API (New) ----
# Billing-enabled Google Cloud key with the "Places API (New)" enabled.
# The discover step sends an X-Goog-FieldMask header (required by Places New).
GOOGLE_MAPS_API_KEY=

# ---- Claude API (personalization) ----
ANTHROPIC_API_KEY=
# Default is a cheap, fast model. Override to taste.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Send pipeline ----
# DRY_RUN=true prints what would send and sends nothing. This is the default.
# Set to false ONLY after legal sign-off (see README compliance note).
DRY_RUN=true
# Seconds to wait between real sends.
RATE_LIMIT=1.0

# SMTP credentials (only needed when DRY_RUN=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=

# ---- CAN-SPAM required footer (only needed when DRY_RUN=false) ----
# A valid physical postal address and a working unsubscribe link are legally
# required on commercial email in the US.
SENDER_POSTAL_ADDRESS=
UNSUBSCRIBE_URL=
